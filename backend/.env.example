# =============================================================================
# Parking Perks — environment variables
# Copy this file to .env and fill in real values. Never commit .env.
# =============================================================================

# --- Database ---
#DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/parking_perks
DATABASE_URL=sqlite+aiosqlite:///./parking_perks.db


# --- Genetec (plate reads) ---
# GENETEC_BASE_URL=https://genetec.your-ubc-host.ca/api
# GENETEC_USERNAME=service_account
# GENETEC_PASSWORD=secret

# --- T2 Iris (payments) ---
# T2_IRIS_BASE_URL=https://iris.your-ubc-host.ca/api/v1
# T2_IRIS_API_KEY=your_api_key

# --- T2 Flex (citations + permits) ---
# T2_FLEX_BASE_URL=https://flex.your-ubc-host.ca/api
# T2_FLEX_CLIENT_ID=client_id
# T2_FLEX_CLIENT_SECRET=client_secret

# --- Email (UBC Exchange/SMTP) ---
SMTP_HOST=smtp.mail.ubc.ca
SMTP_PORT=587
SMTP_USERNAME=parking.perks@ubc.ca
SMTP_PASSWORD=smtp_app_password
EMAIL_FROM=parking.perks@ubc.ca
EMAIL_FROM_NAME=UBC Parking Services

# --- Application ---
MANAGER_CODE=UBCO-PERKS-2025
MIN_VISITS=10
MIN_HOURS=1.0
NUM_WINNERS=1
CAMPUS_TIMEZONE=America/Vancouver

# --- Scheduler ---
# Day of month to run the draw (1 = first of month)
DRAW_DAY_OF_MONTH=1
DRAW_HOUR=9
DRAW_MINUTE=0

# --- Stub mode ---
# Set to true to use local test-data files instead of live APIs
USE_STUBS=true
STUB_DATA_DIR=../test-data
