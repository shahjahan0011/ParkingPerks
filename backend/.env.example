# Copy to .env and fill in values. Never commit .env.

# --- T2 Iris (payments) ---
# Token is generated by Digital Iris — contact your Iris administrator.
# Leave T2_IRIS_BASE_URL as default unless your Iris instance is self-hosted.
T2_IRIS_BASE_URL=https://api.digitalpaytech.com/services
T2_IRIS_TOKEN=

# --- T2 Flex (citations + permits) ---
T2_FLEX_WS_URL=https://ubcparking.t2flex.ca/PowerParkWS/T2_Flex_Misc.asmx
T2_FLEX_USERNAME=
T2_FLEX_PASSWORD=
T2_FLEX_QUERY_PERMITS_UID=4738
T2_FLEX_QUERY_CITATIONS_UID=4742
T2_FLEX_VERIFY_SSL=true
T2_FLEX_TIMEOUT=60.0

# --- Email ---
SMTP_HOST=smtp.mail.ubc.ca
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=parking.perks@ubc.ca
EMAIL_FROM_NAME=UBC Parking Services

# --- Application ---
MANAGER_CODE=change-me
# MIN_VISITS=6  ← for testing with partial reads; use 10 for production
MIN_VISITS=10
MIN_HOURS=1.0
NUM_WINNERS=1
CAMPUS_TIMEZONE=America/Vancouver

# --- Scheduler ---
DRAW_DAY_OF_MONTH=1
DRAW_HOUR=9
DRAW_MINUTE=0

# --- Stub flags (set false as live APIs become available) ---
USE_STUBS=false
USE_STUBS_READS=true
USE_STUBS_PAYMENTS=true
STUB_DATA_DIR=../test-data
UPLOADS_DIR=./uploads
